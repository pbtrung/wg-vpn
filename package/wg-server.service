[Unit]
Description=wg-vpn: publish WireGuard fleet configs (apply)
Documentation=https://github.com/pbtrung/wg-vpn
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=wg-server
Group=wg-server
Environment=WG_SERVER_CONFIG=/etc/wg-server/config.json
ExecStart=/usr/bin/wg-server apply --rotate -v

# Rotates every node's key on every scheduled run (--rotate implies
# immediate cleanup, so no separate --prune is needed). This deviates
# from docs/wg-server.md's general guidance that a routine scheduled
# job should not rotate, since rotation can interrupt a live tunnel
# until each node's wg-client next syncs -- the same deliberate
# tradeoff docker/'s cron image makes; see its README's "Rotation on
# every run" section for the operational consequences (every node must
# sync often enough relative to this schedule, or it can permanently
# miss a generation).

# Sandboxing: this binary only reads the config file and talks to the
# bucket over the network, so it needs neither root nor write access to
# most of the filesystem.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/wg-server

[Install]
WantedBy=multi-user.target
