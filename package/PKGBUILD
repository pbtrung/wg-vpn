# Maintainer: Trung Pham <trung.pham@zedercorp.com.vn>
pkgname=wg-vpn
pkgver=0.1.3
pkgrel=1
pkgdesc="Hub-and-spoke WireGuard fleet manager (wg-server + wg-client)"
arch=('x86_64' 'aarch64')
url="https://github.com/pbtrung/wg-vpn"
license=('MIT')
# wg-client configures the kernel WireGuard interface itself over
# netlink/UAPI (docs/wg-client.md §8) -- no runtime dependency on
# wg/wg-quick/ip/bash. Kept as optional for manual inspection only.
depends=()
optdepends=('wireguard-tools: manual `wg show` inspection of the interface'
            'iproute2: manual `ip addr`/`ip route` inspection of the interface')
backup=()
install=wg-vpn.install
# Prebuilt binaries from a separate release build, not compiled here --
# there's no matching source for makepkg's automatic debug package to
# correlate against, and gdb-add-index fails on their (release-profile,
# already near-stripped) debug info anyway.
options=('!strip' '!debug')

source_x86_64=("https://github.com/pbtrung/wg-vpn/releases/download/v${pkgver}/wg-vpn-x86_64.tar.gz")
sha256sums=('6ea069ee51ffd204e68b66cb4263067a4c40b4c67fa266ad157d3adce609c423'
            '4457edd2fdd412be0dc4fae872817f1806e4277321e013f3d3d09892c1ec4494'
            '59fe93d87d0278d77a9e0d00c6eedf9f5dfc9bf18374448cba557549996af37d'
            '4ac502fc44f449e49b0af8110c8a3fe7b3ff865930b71b30bec2d910678bcd0f'
            'df0effd32b32b87b069ee7f704522cf6c6b6cd372b75c089a0472e8708bb7ba8'
            '43ee3a03927f51dcf681554acbc6e2668dca58fc896001530f5cbfb2fe95af27')
sha256sums_x86_64=('ec84f073a528e08cdcad278ce7a6667675d2f57bc5c212dd121de09fdd070848')
sha256sums_aarch64=('7fe0c78a4c9abae779adcf5e3bea66e0ff3efdad89979e1f72841ce584d07a4a')

source_aarch64=("https://github.com/pbtrung/wg-vpn/releases/download/v${pkgver}/wg-vpn-aarch64.tar.gz")

source=(
    'wg-server.service'
    'wg-server.timer'
    'wg-client.service'
    'wg-client.timer'
    'wg-client-boot.timer'
    "LICENSE::https://raw.githubusercontent.com/pbtrung/wg-vpn/v${pkgver}/LICENSE"
)

package() {
    # makepkg auto-extracts the arch-specific wg-vpn-$CARCH.tar.gz
    # source above (containing both binaries) into $srcdir.
    install -Dm755 "${srcdir}/wg-server" "${pkgdir}/usr/bin/wg-server"
    install -Dm755 "${srcdir}/wg-client" "${pkgdir}/usr/bin/wg-client"

    install -Dm644 "${srcdir}/wg-server.service" \
        "${pkgdir}/usr/lib/systemd/system/wg-server.service"
    install -Dm644 "${srcdir}/wg-server.timer" \
        "${pkgdir}/usr/lib/systemd/system/wg-server.timer"
    install -Dm644 "${srcdir}/wg-client.service" \
        "${pkgdir}/usr/lib/systemd/system/wg-client.service"
    install -Dm644 "${srcdir}/wg-client.timer" \
        "${pkgdir}/usr/lib/systemd/system/wg-client.timer"
    install -Dm644 "${srcdir}/wg-client-boot.timer" \
        "${pkgdir}/usr/lib/systemd/system/wg-client-boot.timer"

    # Config lives here, not shipped by the package -- see wg-vpn.install
    # and README.md "Configure" for the schemas.
    install -dm750 "${pkgdir}/etc/wg-server"
    # wg-client runs as root by default (wg-client.service), so this
    # needs no dedicated group the way /etc/wg-server does -- just kept
    # unreadable by other local users, since config.json holds this
    # node's per-node R2 read-only credentials and session token.
    install -dm750 "${pkgdir}/etc/wg-client"

    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
