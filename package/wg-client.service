[Unit]
Description=wg-vpn: sync this node's WireGuard config (one-shot)
Documentation=https://github.com/pbtrung/wg-vpn
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/wg-client sync --config /etc/wg-client/config.json --once

# Needs root: wg-client shells out to wg-quick/wg/ip, which manage a
# kernel network interface (README.md "Requirements"). Adjust
# ReadWritePaths below if your client config's conf_path isn't under
# /etc/wireguard.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/wg-client
ReadWritePaths=/etc/wireguard
RuntimeDirectory=wg-client
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
